{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts", "db/*.ts", "names.ts", "engine.ts", "wrangler.config.ts", "secrets.ts", "smoke.ts", "worker-configuration.d.ts"]
}
