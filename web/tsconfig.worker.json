{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["WebWorker", "ESNext"],
        "strict": true,
        "skipLibCheck": true,
        "rewriteRelativeImportExtensions": true,
        "verbatimModuleSyntax": true,
        "noEmit": false,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src/worker/**/*.ts"]
}
