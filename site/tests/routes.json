[
  {
    "name": "pages",
    "steps": [
      { "path": "/", "status": 200, "contains": ["<h1"] },
      { "path": "/docs", "status": 302, "location": "/docs/getting-started/introduction" },
      { "path": "/docs/nope/nope", "status": 404 },
      { "path": "/nobody-here", "status": 404, "contains": ["Not found"] },
      { "path": "/settings", "status": 302, "location": "/" }
    ]
  },
  { "name": "every docs page", "docs": true },
  {
    "name": "api while signed out",
    "steps": [
      { "path": "/api/health", "status": 200, "equals": { "ok": true, "users": 1 } },
      { "path": "/api/handles/dylan", "status": 200, "equals": { "available": false } },
      { "path": "/api/handles/docs", "status": 200, "equals": { "available": false } },
      { "path": "/api/handles/{handle}", "status": 200, "equals": { "available": true } },
      { "method": "PATCH", "path": "/api/me", "status": 401, "equals": { "error": "Not signed in." } },
      { "method": "DELETE", "path": "/api/me/accounts/github", "status": 401, "equals": { "error": "Not signed in." } }
    ]
  },
  {
    "name": "oauth without secrets",
    "steps": [
      { "path": "/api/auth/github", "status": 503, "contains": ["Sign-in with github is not configured."] },
      { "path": "/api/auth/google", "status": 503, "contains": ["Sign-in with google is not configured."] },
      { "path": "/api/auth/nope", "status": 404, "contains": ["Unknown provider"] },
      { "path": "/api/auth/callback/github", "status": 400, "contains": ["Invalid state"] }
    ]
  },
  {
    "name": "email sign-in, profile and sign-out",
    "steps": [
      { "method": "POST", "path": "/api/auth/email/start", "json": { "email": "nope" }, "status": 400, "equals": { "error": "Enter a valid email." } },
      { "method": "POST", "path": "/api/auth/email/start", "json": { "email": "{email}" }, "status": 200, "equals": { "ok": true } },
      { "method": "POST", "path": "/api/auth/email/verify", "json": { "email": "{email}", "code": "not-it" }, "status": 200, "equals": { "ok": false, "handle": null } },
      { "method": "POST", "path": "/api/auth/email/verify", "json": { "email": "{email}", "code": "{code}" }, "status": 200, "equals": { "ok": true, "handle": null } },
      { "path": "/settings", "status": 302, "location": "/?welcome" },
      { "method": "PATCH", "path": "/api/me", "json": { "handle": "dylan", "name": "Corpus", "avatar": { "icon": 1, "palette": "sky" } }, "status": 409, "equals": { "error": "@dylan is already taken." } },
      { "method": "PATCH", "path": "/api/me", "json": { "handle": "{handle}", "name": "Corpus", "avatar": { "icon": 1, "palette": "sky" }, "bio": "hello" }, "status": 200, "contains": ["\"handle\":\"{handle}\""] },
      { "path": "/@{handle}", "status": 200, "contains": ["@{handle}", "hello"] },
      { "path": "/settings", "status": 200 },
      { "path": "/api/health", "status": 200, "equals": { "ok": true, "users": 2 } },
      { "method": "POST", "path": "/api/auth/signout", "status": 200, "equals": { "ok": true } },
      { "path": "/settings", "status": 302, "location": "/" }
    ]
  }
]
