---
import { Font } from 'astro:assets'
import '../styles/global.css'
import Header from '../components/header.astro'
import SignIn from '../components/sign-in.astro'
import Footer from '../components/footer.astro'

const GAPS = { xs: 'gap-3', sm: 'gap-4', lg: 'gap-7' }

interface Props {
  title?: string
  description?: string
  gap?: keyof typeof GAPS
  class?: string
}

const { title, description = 'Packages for Edge Python, pinned by sha256.', gap = 'sm', class: className } = Astro.props

// A preview reads absolute addresses, and a query string never names a different page.
const heading = title ? `${title} on Edge Python` : 'Edge Python'
const page = new URL(Astro.url.pathname, Astro.url).href
const card = new URL('/og.png', Astro.url).href
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{heading}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={page} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Edge Python" />
  <meta property="og:title" content={heading} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={page} />
  <meta property="og:image" content={card} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <Font cssVariable="--font-inter" preload />
  <Font cssVariable="--font-jetbrains-mono" />
  <script is:inline>
    document.documentElement.dataset.theme = localStorage.getItem('theme') ?? 'light'
  </script>
</head>
<body class="bg-page text-fg flex min-h-screen flex-col has-[dialog:modal]:overflow-hidden">
  <p class="bg-notice text-notice-fg border-b border-line px-3 py-1.5 text-center text-2xs">
    The package registry is still being built. The <a href="/docs" class="underline">docs</a> are live, everything else is a preview.
  </p>

  <Header />
  <SignIn />
  <main class:list={['p-3.5 w-full max-w-[1200px] mx-auto my-2 text-base flex flex-col', GAPS[gap], className]}>
    <slot />
  </main>
  <Footer />

  <script>
    // Sticky elements rest where they start, measured from the header so the banner never counts.
    const header = document.querySelector('header')

    const place = (el: HTMLElement) => {
      el.style.top = ''
      if (!header || getComputedStyle(el).position !== 'sticky') return

      const gap = el.getBoundingClientRect().top + scrollY - (header.offsetTop + header.offsetHeight)
      el.style.setProperty('--sticky-top', `${header.offsetHeight + gap}px`)
      el.style.setProperty('--sticky-gap', `${gap}px`)
      el.style.top = 'var(--sticky-top)'
    }

    const placeAll = () => document.querySelectorAll<HTMLElement>('[data-sticky]').forEach(place)

    placeAll()
    document.fonts.ready.then(placeAll)
    addEventListener('resize', placeAll)
  </script>
</body>
</html>
