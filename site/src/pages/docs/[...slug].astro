---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/base.astro'
import DocsNav from '../../components/docs-nav.astro'
import Playground from '../../components/playground.astro'
import CodeBlock from '../../components/ui/code-block.astro'
import TableBlock from '../../components/ui/table-block.astro'
import { tree } from '../../lib/docs/tree'

const entries = await getCollection('docs')
const sections = tree(entries, '')
const docs = sections.flatMap((section) => section.docs)

const first = docs[0]
if (!first) return new Response(null, { status: 404 })
// Permanent, so the links people write to /docs count towards the page it opens.
if (!Astro.params.slug) return Astro.redirect(`/docs/${first.slug}`, 301)

const doc = docs.find((each) => each.slug === Astro.params.slug)
if (!doc) return Astro.rewrite('/404')

const entry = entries.find((each) => each.id === doc.id)!
const { Content } = await render(entry)

const origin = (Astro.site ?? Astro.url).origin
const section = sections.find((each) => each.docs.some((one) => one.id === doc.id))

/* A section is not a page, so its crumb borrows the first one it holds. */
const crumbs = [
  { name: 'Docs', item: `${origin}/docs` },
  ...(section?.label && section.docs[0] ? [{ name: section.label, item: `${origin}/docs/${section.docs[0].slug}` }] : []),
  { name: doc.title }
]

const trail = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((crumb, at) => ({ '@type': 'ListItem', position: at + 1, ...crumb }))
}
---

<Base title={doc.title} description={entry.data.description} gap="lg" class="flex-1">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(trail)} />

  <div class="flex flex-col lg:flex-row gap-3 flex-1 min-h-0">
    <DocsNav sections={sections} current={doc} />

    <section class="prose flex-1 min-w-0">
      <Content components={{ Playground, pre: CodeBlock, table: TableBlock }} />
    </section>
  </div>
</Base>
