---
import { env } from 'cloudflare:workers'
import Base from '../layouts/base.astro'
import Icon from '../components/ui/icon.astro'
import Field from '../components/ui/field.astro'
import Avatar from '../components/ui/avatar.astro'
import Agent from '../components/agent.astro'
import { counted, listed } from '../lib/server/packages'
import { publicUser, userByHandle } from '../lib/server/users'
import { avatarFor, type Palette } from '../lib/account/avatar'
import { OWNER } from '../lib/account/handle'
import { count } from '../lib/format'
import { programs } from '../data/programs'
import { hidden } from '../draft'

// Repos a visitor may know, each a tag that opens Edge and rails on it.
const repos = [['rails', 'rails/rails'], ['django', 'django/django'], ['express', 'expressjs/express'], ['flask', 'pallets/flask'], ['next.js', 'vercel/next.js']]

// Publishing needs a token, so signed out the same button opens the sign-in dialog.
const { user } = Astro.locals

// A query narrows the shelf, and it arrives in the url so the form works before any script does.
const asked = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 64)

// Community holds programs and packages on one shelf, std is the maintainer's own.
const sorts = [
  { label: 'Community', href: asked ? `/?${new URLSearchParams({ q: asked })}` : '/', current: true },
  { label: 'std', href: `/@${OWNER}`, current: false }
]

const packages = (await listed(env.DB, { asked: asked || undefined })).results

// A draft program is left off the shelf as it is out of search, since its page answers as missing.
const live = programs.filter((each) => !hidden(`/program/${each.slug}`))

// Every artifact the shelf can show, the packages published and the programs the site ships.
const total = (await counted(env.DB)) + live.length

const shown = live.filter((each) => `${each.name} ${each.description}`.toLowerCase().includes(asked.toLowerCase()))

const authors = new Map(await Promise.all([...new Set(shown.map((each) => each.author))].map(async (handle) => {
  const found = await userByHandle(env.DB, handle)
  return [handle, found ? (publicUser(found).avatar ?? avatarFor(found.id)) : avatarFor(handle)] as const
})))

// Programs and packages share one row, a program has no license and no installs.
const rows = [
  ...shown.map((each) => ({ name: each.name, href: `/program/${each.slug}`, description: each.description as string | null, handle: each.author, avatar: authors.get(each.author)!, license: null as string | null, downloads: null as number | null })),
  ...packages.map((item) => ({ name: item.name, href: `/package/${item.name}`, description: item.description, handle: item.handle, avatar: item.avatar_icon && item.avatar_palette ? { icon: item.avatar_icon, palette: item.avatar_palette as Palette } : avatarFor(item.name), license: item.license, downloads: item.downloads as number | null }))
]

const outline = 'flex items-center gap-2 transition border border-line text-fg-hint px-4 py-1 rounded-full hover:text-fg'
---

<Base description="The package registry for Edge Python. Find a package, pin it by sha256, import it by name.">
  <div class="flex w-full flex-col gap-9">
    <div class="flex flex-wrap items-center sm:items-start gap-x-4 gap-y-2">
      <h1 class="text-xl font-semibold">Edge Python</h1>

      <div class="order-2 sm:order-3 ml-auto sm:ml-0 sm:basis-full flex items-center gap-4 text-2xs text-fg-hint">
        <span class="flex items-center gap-1.5"><Icon name="create" size="xs" />{total} {total === 1 ? 'artifact' : 'artifacts'}</span>
      </div>

      <div class="order-3 sm:order-2 basis-full sm:basis-auto sm:ml-auto flex items-center gap-3 text-sm">
        {user ? (
          <a href="/settings#tokens" class={outline}>
            <Icon name="create" />
            Publish
          </a>
        ) : (
          <button type="button" data-signin-open class={outline}>
            <Icon name="create" />
            Publish
          </button>
        )}
        <button type="button" data-dialog-open="agent" class="flex items-center gap-2 transition bg-fg text-page hover:bg-solid-hover border border-transparent px-4 py-1 rounded-full">
          <Icon name="agent" />
          Connect an agent
        </button>
      </div>
    </div>

    <section data-group="programs" class="flex flex-col items-center gap-4 rounded-2xl border border-line-strong bg-page px-4 py-10">
      <div class="flex flex-col items-center gap-1">
        <span class="flex items-center gap-2 whitespace-nowrap text-xs text-fg-hint">
          <Icon name="tram" size="xs" class="shrink-0" />Edge and rails
        </span>
        
        <p class="text-sm">Edge Python reads your repo code as a graph, not as text.</p>
      </div>

      {/* A repo sent from here lands on the Edge and rails page. */}
      <form data-trace action="/program/edge-and-rails" class="w-full max-w-[520px]">
        <label class="flex h-9 items-center gap-2.5 rounded-full border border-line-emphasis bg-surface px-4 text-sm transition-shadow hover:border-link/60 hover:ring-2 hover:ring-link/20 focus-within:border-link/60 focus-within:ring-2 focus-within:ring-link/20">
          <span class="sr-only">Git repo</span>
          <input name="repo" placeholder="Paste any git repo URL" autocomplete="off" spellcheck="false" class="peer min-w-0 flex-1 bg-transparent outline-none placeholder:text-fg-placeholder" />
          <button type="submit" aria-label="Trace" class="-mr-3 flex size-6.5 shrink-0 items-center justify-center rounded-full bg-fg text-page transition hover:bg-solid-hover peer-placeholder-shown:hidden"><Icon name="up" size="sm" /></button>
        </label>
      </form>

      <div class="flex flex-wrap justify-center gap-2">
        {repos.map(([label, repo]) => <a href={`/program/edge-and-rails?repo=${repo}`} data-repo={repo} class="rounded-full border border-line-strong px-3 py-1 text-xs text-fg-faint transition hover:text-fg">{label}</a>)}
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="ml-4">Artifacts</h2>

      <div class="flex flex-col gap-3 text-sm sm:flex-row sm:items-center">
        <form data-shelf role="search" class="w-full sm:w-[341px]">
          <Field name="q" label="Search artifacts" hideLabel type="search" placeholder="Search artifacts" icon="search" value={asked} class="[&>span]:h-8.5 [&>span]:py-0 [&>span]:transition-shadow [&>span]:focus-within:border-link/60 [&>span]:focus-within:ring-2 [&>span]:focus-within:ring-link/20 [&>span]:hover:border-link/60 [&>span]:hover:ring-2 [&>span]:hover:ring-link/20" />
        </form>

        <div data-sorts class="flex items-center gap-4 sm:ml-auto">
          <span class="text-fg-hint">Sort</span>
          {sorts.map(({ label, href, current }) => (
            <a href={href} data-panel={label} class:list={['rounded-full border border-line-strong px-3 py-1 text-xs', current ? 'text-fg' : 'text-fg-faint transition hover:text-fg']}>
              <span>{label}</span>
            </a>
          ))}
        </div>
      </div>

      <div data-cards>
        {rows.length > 0 ? (
          <ul class="divide-y divide-line-strong overflow-hidden rounded-2xl border border-line-strong bg-page">
            {/* Names the columns, and leaves them unnamed below 640px where the license hides. */}
            <li aria-hidden="true" class="hidden items-center gap-4 bg-surface px-4 py-2 text-2xs text-fg-hint sm:flex">
              <span class="flex-1">Name</span>
              <span class="w-36">Author</span>
              <span class="w-24 text-right">License</span>
              <span class="w-12 text-right">Installs</span>
            </li>
            {rows.map((row) => (
              <li class="relative flex items-center gap-4 px-4 py-3 transition hover:bg-surface has-[a:focus-visible]:bg-surface">
                <div class="min-w-0 flex-1">
                  <a href={row.href} class="text-sm font-medium after:absolute after:inset-0 focus-visible:outline-none">{row.name}</a>
                  {row.description && <p class="truncate text-xs text-fg-hint">{row.description}</p>}
                </div>
                <a href={`/@${row.handle}`} class="relative flex shrink-0 items-center gap-2 text-xs text-fg-hint transition hover:text-fg sm:w-36">
                  <Avatar {...row.avatar} size="sm" />
                  <span class="hidden truncate sm:inline">@{row.handle}</span>
                </a>
                <span class="hidden w-24 text-right text-2xs text-fg-hint sm:block">{row.license ?? 'Program'}</span>
                <span class="w-12 text-right text-2xs tabular-nums text-fg-disabled">{row.downloads === null ? '' : count(row.downloads)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="ml-4 text-sm text-fg-hint">{asked ? 'Nothing matches that.' : 'No artifacts yet.'}</p>
        )}
      </div>
    </section>
  </div>

  <Agent />
</Base>

<script>
  // Short enough to feel like typing, long enough that one word is one request.
  const WAIT = 120

  // A tag writes its repo into the trace input, and without a script it opens the trace.
  const trace = document.querySelector<HTMLInputElement>('[data-trace] input')
  for (const tag of document.querySelectorAll<HTMLAnchorElement>('[data-repo]')) {
    tag.addEventListener('click', (event) => {
      if (!trace) return
      event.preventDefault()
      trace.value = tag.dataset.repo ?? ''
      trace.focus()
    })
  }

  const form = document.querySelector<HTMLFormElement>('[data-shelf]')
  const input = form?.querySelector<HTMLInputElement>('input')
  const cards = document.querySelector<HTMLElement>('[data-cards]')

  if (form && input && cards) {
    let running: AbortController | null = null
    let timer = 0

    /* The shelf is asked for as a page, not as json, so the cards it answers with are the same markup the server already knows how to draw. */
    const narrow = async (asked: string) => {
      const params = new URLSearchParams(location.search)
      if (asked) params.set('q', asked)
      else params.delete('q')
      const url = params.size ? `/?${params}` : '/'

      running?.abort()
      running = new AbortController()

      try {
        const answer = await fetch(url, { signal: running.signal, headers: { accept: 'text/html' } })
        const page = new DOMParser().parseFromString(await answer.text(), 'text/html')
        // The sort links carry the query too, so they are redrawn beside the cards.
        for (const region of ['[data-cards]', '[data-sorts]']) {
          const drawn = page.querySelector(region)
          if (drawn) document.querySelector(region)?.replaceChildren(...drawn.childNodes)
        }
        history.replaceState(null, '', url)
      } catch (error) {
        // An aborted request is the next keystroke arriving, which is not a failure to report.
        if ((error as Error).name !== 'AbortError') throw error
      }
    }

    // The url already holds the query, so a submit would only reload what the script just drew.
    form.addEventListener('submit', (event) => event.preventDefault())

    input.addEventListener('input', () => {
      clearTimeout(timer)
      timer = window.setTimeout(() => narrow(input.value.trim()), WAIT)
    })
  }
</script>

