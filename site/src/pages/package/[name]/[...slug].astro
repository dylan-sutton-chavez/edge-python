---
import { env } from 'cloudflare:workers'
import Base from '../../../layouts/base.astro'
import DocsNav from '../../../components/docs-nav.astro'
import Playground from '../../../components/playground.astro'
import CodeBlock from '../../../components/ui/code-block.astro'
import Avatar from '../../../components/ui/avatar.astro'
import Icon from '../../../components/ui/icon.astro'
import { avatarFor } from '../../../lib/account/avatar'
import { packed } from '../../../lib/server/bundle'
import { identify } from '../../../lib/server/license'
import { keyOf, named, packageByName, versionsOf } from '../../../lib/server/packages'
import { publicUser, userById } from '../../../lib/server/users'
import { bytes, count, on } from '../../../lib/format'
import { entries, render } from '../../../lib/docs/page'
import { tree } from '../../../lib/docs/tree'

const name = String(Astro.params.name ?? '').toLowerCase()
if (!named(name)) return Astro.rewrite('/404')

const held = await packageByName(env.DB, name)
if (!held) return Astro.rewrite('/404')

const { results } = await versionsOf(env.DB, name)
const releases = results.filter((each) => each.yanked_at === null)

const latest = releases[0]
if (!latest) return Astro.rewrite('/404')

// The artifact is the release, so what a listing does not index is read back out of the bytes that will run.
const object = await env.CDN_BUCKET.get(keyOf(name, latest.version))
if (!object) return Astro.rewrite('/404')

const artifact = packed(new Uint8Array(await object.arrayBuffer()))

const sections = tree(entries(artifact.docs), '')
const docs = sections.flatMap((section) => section.docs)

const doc = Astro.params.slug ? docs.find((each) => each.slug === Astro.params.slug) : docs[0]
if (Astro.params.slug && !doc) return Astro.rewrite('/404')

const page = doc ? await render(doc.id, artifact.docs[doc.id]!) : null

const author = await userById(env.DB, held.user_id)
const shown = author && publicUser(author)

const description = typeof artifact.description === 'string' ? artifact.description : null
const repository = typeof artifact.repository === 'string' ? artifact.repository : null
const license = artifact.notice && identify(artifact.notice)

const base = `/package/${name}`
const meta = [`${count(held.downloads)} downloads`, license, bytes(latest.size)].filter(Boolean)
const dot = 'text-fg-disabled'

// A column keeps its own width so the table scrolls instead of squeezing the dates on a phone.
const cell = 'px-6 py-3 text-left whitespace-nowrap min-w-40'
const head = `${cell} font-normal text-fg-subtle`
const row = `${cell} border-t border-line-strong`
---

<Base title={`${name} ${latest.version}`} description={description ?? `The ${name} package on Edge Python.`} gap="lg" class="flex-1">
  <div>
    <div class="flex flex-wrap items-baseline gap-3">
      <h1 class="text-xl font-semibold">{name}</h1>
      <span class="font-mono text-xs text-fg-subtle">{latest.version}</span>
    </div>

    {description && <p class="mt-3 text-fg-muted">{description}</p>}

    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-fg-subtle">
      {shown?.handle && (
        <a href={`/@${shown.handle}`} class="flex items-center gap-2 transition hover:text-fg">
          <Avatar {...(shown.avatar ?? avatarFor(shown.id))} />
          <span>@{shown.handle}</span>
        </a>
      )}

      {meta.map((item) => <><span class={dot}>·</span><span>{item}</span></>)}

      {repository && (
        <span class="flex items-center gap-3">
          <span class={dot}>·</span>

          <a href={repository} rel="noopener" class="flex items-center gap-1.5 transition hover:text-fg">
            <Icon name="github" size="sm" />Repository
          </a>
        </span>
      )}
    </div>
  </div>

  <div>
    <CodeBlock data-language="bash">edge add {name}</CodeBlock>

    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-2">
      <p class="flex min-w-0 items-center gap-2 text-2xs text-fg-hint">
        <Icon name="locked" size="sm" />
        <span class="min-w-0 truncate font-mono" title={latest.digest}>sha256-{latest.digest}</span>
      </p>
    </div>
  </div>

  {page && doc && (
    <div class="flex flex-col lg:flex-row gap-3 flex-1 min-h-0">
      <DocsNav sections={sections} current={doc} base={base} />

      <section class="prose flex-1 min-w-0">
        <h2>{doc.title}</h2>

        {page.blocks.map((block) => (
          block.kind === 'prose' ? <Fragment set:html={block.html} /> : <Playground code={block.code} output={block.output} />
        ))}
      </section>
    </div>
  )}

  <section class="flex flex-col gap-3">
    <h2 class="ml-4">Versions</h2>

    <div class="bg-page border border-line-strong rounded-2xl overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      <table class="w-max min-w-full text-sm">
        <thead>
          <tr>
            <th class={head}>Version</th>
            <th class={head}>Published</th>
            <th class={head}>Size</th>
          </tr>
        </thead>

        <tbody>
          {releases.map((release) => (
            <tr>
              <td class={row}>
                <span class="flex items-center gap-3">
                  <span class="font-mono text-xs">{release.version}</span>
                  {release.version === latest.version && <span class="text-2xs text-fg-hint">current</span>}
                </span>
              </td>
              <td class:list={[row, 'text-fg-muted']}>{on(release.published_at)}</td>
              <td class:list={[row, 'text-fg-muted tabular-nums']}>{bytes(release.size)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
