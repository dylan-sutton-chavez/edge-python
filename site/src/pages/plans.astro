---
import Base from '../layouts/base.astro'
import PlanPicker from '../components/plan-picker.astro'
---

<Base title="Plans" description="What a plan covers, and what it costs." gap="lg" class="flex-1">
  <div>
    <h1 class="text-xl font-semibold">Plans</h1>
    <p class="mt-3 text-fg-muted">What you keep, for how long, and how provable it is.</p>
  </div>

  <PlanPicker />

  {/* The sandbox is the product's integrity, so no tier sells it back. */}
  <p class="text-xs text-fg-hint">The sandbox, the metered limits and the determinism are in every plan.</p>
</Base>
