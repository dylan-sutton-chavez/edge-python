---
interface Props {
  always?: boolean
}

const { always = false } = Astro.props
---

{/* Drawn over the site while it scrolls, or always on a page that asks for it. */}
<div data-scrollbar data-always={always ? '' : undefined} aria-hidden="true" class="pointer-events-none fixed right-0.5 top-0 z-50 w-1 rounded-full bg-fg-disabled opacity-0 transition-[opacity,background-color] duration-200 before:absolute before:inset-y-0 before:-inset-x-1.5 hover:bg-fg-hint data-dragging:bg-fg-hint data-shown:pointer-events-auto data-shown:opacity-100"></div>

<script>
  import { scrollbar } from '../../lib/scrollbar'

  const bar = document.querySelector<HTMLElement>('[data-scrollbar]')!
  const { moved, held } = scrollbar(bar, 'y', (offset) => scrollTo(scrollX, offset))
  const span = () => ({ offset: scrollY, view: innerHeight, total: document.documentElement.scrollHeight, track: innerHeight })
  addEventListener('scroll', () => moved(span()), { passive: true })

  // Held the way a resting pointer holds it, so it never fades.
  if (bar.hasAttribute('data-always')) {
    held(span())
    addEventListener('resize', () => held(span()))
  }
</script>
