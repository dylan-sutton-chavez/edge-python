interface Props {
  name: keyof typeof ICONS
  size?: keyof typeof SIZES
  class?: string
}

const { name, size = 'md', class: className } = Astro.props
const { width, round, box = '0 0 24 24', solid = false, body }: Glyph = ICONS[name]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={box}
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? undefined : 'currentColor'}
  stroke-width={solid ? undefined : width}
  stroke-linecap={!solid && round ? 'round' : undefined}
  stroke-linejoin={!solid && round ? 'round' : undefined}
  aria-hidden="true"
  class:list={[SIZES[size], className]}
  set:html={body}
/>
