---
import Dialog from './dialog.astro'
---

{/* One dialog the page reuses, the script fills in what it asks and what the button says. */}
<Dialog id="confirm" title="Are you sure?">
  <p data-confirm-body class="text-fg-muted"></p>

  <label data-confirm-code hidden class="flex flex-col gap-1.5">
    <span class="text-xs text-fg-hint">Enter the six digit code we just emailed you</span>

    <input
      name="confirm-code"
      inputmode="numeric"
      autocomplete="one-time-code"
      maxlength="6"
      placeholder="000000"
      class="w-full rounded-2xl border border-line-strong bg-page px-4 py-2 font-mono tracking-[0.3em] outline-none transition focus:border-line-emphasis placeholder:text-fg-placeholder placeholder:tracking-[0.3em]"
    />
  </label>

  <p data-confirm-error hidden class="text-2xs text-danger"></p>

  <div class="flex items-center justify-end gap-3">
    <button type="button" data-dialog-close class="flex items-center gap-2 transition border border-line text-fg-hint px-4 py-1 rounded-full hover:text-fg">Cancel</button>
    <button type="button" data-confirm-go class="flex items-center gap-2 transition border border-line text-fg-hint px-4 py-1 rounded-full hover:text-danger">Delete</button>
  </div>
</Dialog>
