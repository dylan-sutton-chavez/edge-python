---
import type { HTMLAttributes } from 'astro/types'

interface Props extends HTMLAttributes<'div'> {
  axis: 'x' | 'y'
}

const { axis, class: className, ...attrs } = Astro.props

// Along the foot or the right of a box, shown while a pointer rests in it or it scrolls that way.
const thumb = 'pointer-events-none absolute rounded-full bg-fg-disabled opacity-0 transition-[opacity,background-color] duration-200 before:absolute hover:bg-fg-hint data-dragging:bg-fg-hint data-shown:pointer-events-auto data-shown:opacity-100'
const along = axis === 'x' ? 'bottom-0.5 left-0 h-1 before:inset-x-0 before:-inset-y-1.5' : 'right-0.5 top-0 w-1 before:inset-y-0 before:-inset-x-1.5'
---

<div {...attrs} aria-hidden="true" class:list={[thumb, along, className]}></div>
