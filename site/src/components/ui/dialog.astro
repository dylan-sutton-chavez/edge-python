---
import Icon from './icon.astro'

interface Props {
  id: string
  title: string
  subtitle?: string
  gap?: string
  [key: string]: unknown
}

const { id, title, subtitle, gap = 'gap-5', ...attrs } = Astro.props
---

<dialog {...attrs} data-dialog={id} aria-labelledby={`${id}-title`} class="outline-none backdrop:bg-scrim backdrop:backdrop-blur-[1px] m-auto w-[calc(100%-1.75rem)] max-w-[520px] max-h-[calc(100dvh-3.5rem)] bg-transparent text-fg">
  <section class:list={['bg-page border border-line-strong rounded-2xl p-6 flex flex-col text-sm max-h-[inherit] overflow-y-auto overscroll-contain', gap]}>
    <div class="flex flex-col gap-1">
      <div class="flex items-center">
        <h2 id={`${id}-title`} data-title class="text-base font-semibold">{title}</h2>

        <button type="button" data-dialog-close aria-label="Close" class="ml-auto text-fg-hint hover:text-fg transition">
          <Icon name="close" size="sm" />
        </button>
      </div>

      {subtitle && <p data-subtitle class="text-fg-faint">{subtitle}</p>}
    </div>

    <slot />
  </section>
</dialog>

<script>
  // Any element opens a dialog by naming it, and any close button finds the one it sits in.
  document.querySelectorAll<HTMLElement>('[data-dialog-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      document.querySelector<HTMLDialogElement>(`[data-dialog="${trigger.dataset.dialogOpen}"]`)?.showModal()
    })
  })

  document.querySelectorAll('[data-dialog-close]').forEach((button) => {
    button.addEventListener('click', () => button.closest('dialog')?.close())
  })

  // A press that starts inside and ends on the backdrop is a drag, not a dismissal.
  document.querySelectorAll<HTMLDialogElement>('[data-dialog]').forEach((dialog) => {
    let inside = false

    dialog.addEventListener('mousedown', (event) => { inside = event.target !== dialog })
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && !inside) dialog.close()
    })
  })
</script>
