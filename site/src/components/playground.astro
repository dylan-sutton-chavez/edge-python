---
import { env } from 'cloudflare:workers'
import Icon from './ui/icon.astro'
import Thumb from './ui/thumb.astro'
import { COLORS } from '../lib/docs/shiki'

interface Props {
  // The example's edge-manifest as written, an empty one when it declares none.
  manifest?: string
  code: string
  name?: string
  output?: string
  placeholder?: string
  minLines?: number
  maxLines?: number
  outputMaxLines?: number
  // A package page's own package, by name to its version, beside what the example imports.
  imports?: Record<string, string>
}

const { manifest: written = '{}', code, name, output = '', placeholder, minLines = 1, maxLines = 10, outputMaxLines = 5, imports } = Astro.props

const rows = Math.min(Math.max(code.split('\n').length, minLines), maxLines)

/* A value opened `open` levels deep and kept on one line below that, a list of plain values never split across lines. */
function layout(value: unknown, open: number, pad = ''): string {
  if (value === null || typeof value !== 'object') return JSON.stringify(value)
  const inner = `${pad}  `
  if (Array.isArray(value)) {
    if (open <= 0 || value.every((each) => each === null || typeof each !== 'object')) return `[${value.map((each) => layout(each, 0)).join(', ')}]`
    return `[\n${value.map((each) => `${inner}${layout(each, open - 1, inner)}`).join(',\n')}\n${pad}]`
  }
  const entries = Object.entries(value)
  if (entries.length === 0) return '{}'
  if (open <= 0) return `{ ${entries.map(([key, each]) => `${JSON.stringify(key)}: ${layout(each, 0)}`).join(', ')} }`
  return `{\n${entries.map(([key, each]) => `${inner}${JSON.stringify(key)}: ${layout(each, open - 1, inner)}`).join(',\n')}\n${pad}}`
}

/* What the example runs under, shown as the file it would be in a project, the page's own package beside its imports, as open as the height of the code allows. */
const manifest = (() => {
  try {
    const declared = JSON.parse(written)
    const shown = imports ? { ...declared, imports: { ...declared.imports, ...imports } } : declared
    for (let open = 8; open > 0; open--) {
      const text = layout(shown, open)
      if (text.split('\n').length <= rows) return text
    }
    return layout(shown, 0)
  } catch {
    return written
  }
})()

const panel = 'bg-panel rounded-2xl mb-6'
const card = 'relative bg-page border border-line-strong rounded-2xl overflow-hidden p-4'
const footer = 'flex items-center justify-between py-3 px-[17px] text-2xs text-fg-hint'
// The header's own menu, shown while the script below marks its group open.
const menu = 'invisible absolute left-0 top-full z-10 pt-2 opacity-0 -translate-y-1 transition-all group-data-open/file:visible group-data-open/file:opacity-100 group-data-open/file:translate-y-0'
const pick = 'block w-full px-4 py-1 text-left text-fg-subtle hover:bg-line-strong hover:text-fg aria-current:bg-line-strong aria-current:text-fg transition'

// Each file is a textarea over the highlighted copy of itself.
const pane = '-m-4 grid overflow-auto font-mono leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden'
const paint = 'pointer-events-none col-start-1 row-start-1 m-0 whitespace-pre p-4 font-mono leading-code'
const field = 'col-start-1 row-start-1 w-full resize-none overflow-hidden whitespace-pre border-0 bg-transparent p-4 font-mono leading-code text-transparent caret-fg outline-none placeholder:text-fg-placeholder selection:bg-link/30 selection:text-transparent'
const tall = `max-height:calc(${maxLines} * var(--leading-code) + 2rem)`
// The output and the trace share one box, so switching between them never moves the page.
const box = `min-height:calc(${minLines} * var(--leading-code) + 2rem);max-height:calc(${outputMaxLines} * var(--leading-code) + 2rem)`
---

<div data-playground data-cdn={env.CDN} data-min={minLines} data-rows={rows} data-expected={output}>
  <div class={panel}>
    <div class:list={[card, 'text-xs']}>
      <div class={pane} style={tall}>
        <pre aria-hidden="true" class={paint}><code data-view class={COLORS}></code></pre>
        <textarea
          data-input name={name} rows={rows} placeholder={placeholder} spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="Edge Python source"
          class={field}>{code}</textarea>
      </div>

      <div data-manifest hidden class={pane} style={tall}>
        <pre aria-hidden="true" class={paint}><code class={COLORS}></code></pre>
        <textarea rows={rows} spellcheck="false" autocomplete="off" autocapitalize="off" aria-label="edge.json" class={field}>{manifest}</textarea>
      </div>

      <Thumb axis="x" data-bar="x" />
      <Thumb axis="y" data-bar="y" />
    </div>

    <div class={footer}>
      <div data-files class="group/file relative">
        <button type="button" class="flex items-center gap-1 text-fg-subtle transition hover:text-fg">
          <span data-file>main.py</span>
          <Icon name="next" size="sm" class="rotate-90 text-fg-hint transition-transform group-data-open/file:-rotate-90" />
        </button>

        <div class={menu}>
          <div class="w-36 bg-surface border border-line rounded-2xl py-3 text-xs">
            {['main.py', 'edge.json'].map((each) => (
              <button type="button" data-pick={each} aria-current={each === 'main.py' ? 'true' : undefined} class={pick}>{each}</button>
            ))}
          </div>
        </div>
      </div>

      <button type="button" data-rerun aria-label="Run" class="flex text-fg-hint transition hover:text-fg-muted">
        <Icon name="rotate" size="xs" />
      </button>
    </div>
  </div>

  <div class={panel}>
    <div class:list={[card, 'text-xs']}>
      <pre
        data-output
        class="-m-4 p-4 overflow-auto whitespace-pre font-mono leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        style={box}
      >{output}</pre>

      <div data-trace hidden class="@container -m-4 p-4 overflow-auto font-mono text-2xs leading-5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" style={box}>
        {/* Rows keep at least 24rem and scroll sideways like the output instead of squeezing. */}
        <div data-rows class="w-max min-w-[max(100%,24rem)]"></div>
      </div>

      <Thumb axis="x" data-bar="x" />
      <Thumb axis="y" data-bar="y" />
    </div>

    <div class={footer}>
      <span data-status>Output</span>

      {/* Shown once a run reports a trace, which a host built before traces never does. */}
      <button type="button" data-trace-toggle hidden class="flex items-center gap-1.5 text-fg-hint transition hover:text-fg-muted">
        <span data-trace-shows="trace" class="flex"><Icon name="binoculars" size="2xs" /></span>
        <span data-trace-shows="output" class="hidden"><Icon name="output" size="2xs" /></span>
        <span data-trace-label>Trace</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { createEditor } from '../lib/playground/editor'
  import { createHighlight } from '../lib/playground/highlight'
  import { applyControls } from '../lib/playground/terminal'
  import { run, type Manifest, type Phase } from '../lib/playground/runtime'
  import { createTrace } from '../lib/playground/trace'
  import { scrollbar } from '../lib/scrollbar'

  const PHASES: Record<Phase, string> = {
    lock: 'generating edge.lock…',
    runtime: 'loading runtime…',
    worker: 'initializing worker…',
    running: 'running…'
  }

  // How long typing pauses before the edit runs.
  const SETTLE = 400

  document.querySelectorAll<HTMLElement>('[data-playground]').forEach((root) => {
    const input = root.querySelector<HTMLTextAreaElement>('[data-input]')
    const view = root.querySelector<HTMLElement>('[data-view]')
    const output = root.querySelector<HTMLElement>('[data-output]')
    const status = root.querySelector<HTMLElement>('[data-status]')

    if (!input || !view || !output || !status) return

    const manifest = root.querySelector<HTMLElement>('[data-manifest]')!
    const declared = manifest.querySelector('textarea')!
    const expected = root.dataset.expected ?? ''
    const list = root.querySelector<HTMLElement>('[data-trace]')!
    const toggle = root.querySelector<HTMLButtonElement>('[data-trace-toggle]')!
    const trace = createTrace(list.querySelector<HTMLElement>('[data-rows]')!)
    let running = false
    let queued = false
    let timer = 0
    // The source and the edge.json the output shows, so a pause that changed neither runs nothing.
    const snapshot = () => `${input.value}\0${declared.value}`
    let ran = snapshot()

    // A long print keeps its newest lines in view.
    const write = (text: string) => {
      output.textContent = text
      output.scrollTop = output.scrollHeight
    }

    const highlight = createHighlight(() => {
      editor.refresh()
      json.refresh()
    })

    const editor = createEditor({
      input,
      view,
      highlight,
      minLines: Number(root.dataset.min) || 1
    })

    const json = createEditor({
      input: declared,
      view: manifest.querySelector('code')!,
      highlight,
      // As tall as the code, so switching files never moves the page.
      minLines: Number(root.dataset.rows) || 1,
      lang: 'json'
    })

    async function start() {
      if (running) return void (queued = true)
      running = true
      ran = snapshot()

      let buffer = ''
      trace.reset()

      try {
        // The example runs under the edge.json its tab holds, edits included.
        let parsed: unknown
        try {
          parsed = JSON.parse(json.getCode())
        } catch {
          throw new Error('edge.json is not valid JSON')
        }

        const result = await run(
          editor.getCode(),
          root.dataset.cdn!,
          parsed as Manifest,
          (chunk) => {
            buffer += chunk
            write(applyControls(buffer).replace(/\n$/, ''))
          },
          (phase) => { status!.textContent = `Output, ${PHASES[phase]}` },
          (event) => trace.push(event)
        )

        trace.finish(result.ms)
        toggle.hidden = !result.traced

        const text = applyControls(buffer).replace(/\n$/, '')
        write([text, result.error].filter(Boolean).join('\n'))

        status!.textContent = result.error
          ? 'Output, failed'
          : expected && text.trimEnd() !== expected.trimEnd()
            ? 'Output, differs'
            : `Output, ${result.ms < 1000 ? `${result.ms.toFixed(0)}ms` : `${(result.ms / 1000).toFixed(2)}s`}`
      } catch (error) {
        write(String((error as Error)?.message ?? error))
        status!.textContent = 'Output, failed'
      } finally {
        running = false
        if (queued) {
          queued = false
          settle()
        }
      }
    }

    // An edit to either file runs once typing pauses, and one landing mid run waits for that run to end.
    const settle = () => {
      if (snapshot() !== ran) start()
    }

    for (const field of [input, declared]) {
      field.addEventListener('input', () => {
        clearTimeout(timer)
        timer = window.setTimeout(settle, SETTLE)
      })
    }

    // Runs the example as it stands, once, after which an edit is what runs it again.
    const rerun = root.querySelector<HTMLButtonElement>('[data-rerun]')!
    rerun.addEventListener('click', () => {
      rerun.hidden = true
      start()
    }, { once: true })

    root.querySelectorAll<HTMLElement>('[data-bar]').forEach((bar) => {
      const box = bar.parentElement!
      const x = bar.dataset.bar === 'x'
      const shown = () => [...box.children].find((child): child is HTMLElement => !child.hasAttribute('data-bar') && !(child as HTMLElement).hidden)!
      const offset = (scroller: HTMLElement) => (x ? scroller.scrollLeft : scroller.scrollTop)
      const span = (scroller: HTMLElement) => x
        ? { offset: scroller.scrollLeft, view: scroller.clientWidth, total: scroller.scrollWidth, track: box.clientWidth }
        : { offset: scroller.scrollTop, view: scroller.clientHeight, total: scroller.scrollHeight, track: box.clientHeight }
      // Kept to the flat of each side, clear of the rounded corners.
      const { moved, held } = scrollbar(bar, x ? 'x' : 'y', (to) => shown().scrollTo(x ? { left: to } : { top: to }), parseFloat(getComputedStyle(box).borderBottomLeftRadius))
      const last = new WeakMap<EventTarget, number>()

      box.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') held(span(shown())) })
      box.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') held(null) })

      // Scroll never bubbles, so the box catches it on the way down, moves along this bar only.
      box.addEventListener('scroll', (event) => {
        const scroller = event.target as HTMLElement
        if ((last.get(scroller) ?? 0) === offset(scroller)) return
        last.set(scroller, offset(scroller))
        moved(span(scroller))
      }, { capture: true, passive: true })
    })

    // The box shows what the run printed or what it reached, one at a time.
    toggle.addEventListener('click', () => {
      const showing = list.hidden
      list.hidden = !showing
      output.hidden = showing
      toggle.querySelector('[data-trace-label]')!.textContent = showing ? 'Output' : 'Trace'
      toggle.querySelectorAll<HTMLElement>('[data-trace-shows]').forEach((icon) => icon.classList.toggle('hidden', (icon.dataset.traceShows === 'output') !== showing))
    })

    // Picking a file swaps what the one box shows, and the menu marks the one now open.
    const source = input.parentElement!
    const open = root.querySelector<HTMLElement>('[data-file]')!
    const picks = root.querySelectorAll<HTMLButtonElement>('[data-pick]')
    const files = root.querySelector<HTMLElement>('[data-files]')!
    const show = (on: boolean) => files.toggleAttribute('data-open', on)

    // Only a mouse opens it by hovering, since a phone keeps the hover after a tap.
    files.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') show(true) })
    files.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') show(false) })
    open.closest('button')!.addEventListener('click', () => show(!files.hasAttribute('data-open')))
    files.addEventListener('focusout', (event) => { if (!files.contains(event.relatedTarget as Node)) show(false) })
    document.addEventListener('pointerdown', (event) => { if (!files.contains(event.target as Node)) show(false) })

    picks.forEach((pick) =>
      pick.addEventListener('click', () => {
        const code = pick.dataset.pick === 'main.py'
        source.hidden = !code
        manifest.hidden = code
        open.textContent = pick.dataset.pick!
        picks.forEach((each) => (each === pick ? each.setAttribute('aria-current', 'true') : each.removeAttribute('aria-current')))
        show(false)
      })
    )
  })
</script>
