---
import Icon from './ui/icon.astro'
import Dialog from './ui/dialog.astro'

// A mock briefing until the real one is generated.
const briefing = `
Edge Python is a sandboxed Python subset that compiles to bytecode and runs on a VM, in the browser as WebAssembly or through the edge CLI.
Install the CLI with curl -fsSL https://cdn.edgepython.com/cli/install.sh | sh
Read https://edgepython.com/SKILL.md first, it is the full reference and every example in it is executable.
Nothing resolves unless edge.json declares it, so run edge add <name> before importing and grant what it asks under permissions for each scope.
Run the entry point with edge run main.py and every *_test.py with edge test.
Search the docs, people, programs and packages with GET https://edgepython.com/api/search?q=<term>
Read what it finds by putting /api before the href, so /package/<name>, /package/<name>/<slug>, /@<handle>, /program/<name> and /docs/<path> all answer as data, and GET /api/docs lists the reference.
Ask a question in any language with POST https://ask.edgepython.com {"question": "..."}, which answers from those pages and returns a session to send back with a follow-up.
Pack and ship with edge build, then edge publish app.edge
`

// The native bar stays hidden, so this one shows while the briefing scrolls sideways.
const xbar = 'pointer-events-none absolute bottom-0.5 left-0 h-1 rounded-full bg-fg-disabled opacity-0 transition-[opacity,background-color] duration-200 before:absolute before:inset-x-0 before:-inset-y-1.5 hover:bg-fg-hint data-dragging:bg-fg-hint data-shown:pointer-events-auto data-shown:opacity-100'
---

<Dialog id="agent" title="Connect an agent" subtitle="Copy and paste this into your agent session.">
  <div class="relative rounded-2xl border border-line-emphasis bg-surface overflow-hidden p-4">
    <pre data-briefing class="-m-4 p-4 overflow-auto whitespace-pre font-mono text-xs leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">{briefing}</pre>
    <div data-briefing-bar aria-hidden="true" class={xbar}></div>
  </div>

  <button type="button" data-agent-copy class="flex items-center justify-center gap-2 px-4 py-2 rounded-full transition bg-fg text-page hover:bg-solid-hover border border-transparent">
    <Icon name="file" size="sm" class="stroke-2" /><span data-agent-copy-label>Copy</span>
  </button>
</Dialog>

<script>
  import { scrollbar } from '../lib/scrollbar'

  const RESET = 1200

  const briefing = document.querySelector<HTMLElement>('[data-briefing]')
  const label = document.querySelector<HTMLElement>('[data-agent-copy-label]')
  const bar = document.querySelector<HTMLElement>('[data-briefing-bar]')

  if (briefing && bar) {
    const box = briefing.parentElement!
    const span = () => ({ offset: briefing.scrollLeft, view: briefing.clientWidth, total: briefing.scrollWidth, track: box.clientWidth })
    // Kept to the flat of the bottom edge, clear of the rounded corners.
    const { moved, held } = scrollbar(bar, 'x', (to) => briefing.scrollTo({ left: to }), parseFloat(getComputedStyle(box).borderBottomLeftRadius))

    box.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') held(span()) })
    box.addEventListener('pointerleave', (event) => { if (event.pointerType === 'mouse') held(null) })
    briefing.addEventListener('scroll', () => moved(span()), { passive: true })
  }

  let timer: ReturnType<typeof setTimeout> | undefined

  document.querySelector('[data-agent-copy]')?.addEventListener('click', async () => {
    if (!briefing || !label) return

    try {
      await navigator.clipboard.writeText(briefing.textContent ?? '')
      label.textContent = 'Copied'
    } catch {
      label.textContent = "Couldn't copy"
    }

    clearTimeout(timer)
    timer = setTimeout(() => { label.textContent = 'Copy' }, RESET)
  })
</script>
