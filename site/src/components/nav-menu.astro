---
import Icon from './ui/icon.astro'
import Sheet from './ui/sheet.astro'

type Entry = { label: string; href: string }

interface Props {
  current: string
  class?: string
}

const links: { label: string; pages: Entry[] }[] = [
  { label: 'Explore', pages: [{ label: 'Community', href: '/' }] },
  { label: 'Docs', pages: [{ label: 'Overview', href: '/docs' }] }
]

const { current, class: className } = Astro.props

// A section page like /docs/quickstart/overview still belongs to the /docs entry.
const at = (href: string) => current === href || (href !== '/' && current.startsWith(`${href}/`))

const here = links.find((link) => link.pages.some((page) => at(page.href)))

const item = 'px-2 sm:px-3 py-1 rounded-full flex items-center gap-1 shrink-0 whitespace-nowrap transition focus-visible:ring-1 focus-visible:ring-line-emphasis focus-visible:outline-none'
const row = 'block px-4 py-1.5 hover:bg-line-strong transition'
const sheetRow = 'flex items-center gap-2 w-full px-4 py-1.5 text-left hover:bg-line-strong transition'
---

<nav aria-label="Main" class:list={['flex items-center gap-1 sm:gap-2', className]}>
  <div class="hidden lg:flex items-center gap-1 sm:gap-2">
    {links.map((link, index) => {
      const id = `nav-${index}`

      return (
        <div class="group" data-nav style={`--anchor: --${id}`}>
          <button
            type="button"
            data-nav-trigger
            aria-expanded="false"
            aria-controls={id}
            class:list={[item, link === here ? 'text-fg' : 'text-fg-subtle hover:text-fg']}
          >
            <span>{link.label}</span>
            <Icon name="next" size="sm" class="rotate-90 text-fg-hint transition-transform group-has-[[data-nav-panel]:popover-open]:-rotate-90" />
          </button>

          <div popover id={id} data-nav-panel class="panel w-52 inset-auto m-0 p-0 pt-2 border-0 bg-transparent -translate-y-1 opacity-0 open:translate-y-0 open:opacity-100 starting:open:-translate-y-1 starting:open:opacity-0 transition-all transition-discrete">
            <ul class="bg-surface border border-line rounded-2xl py-3 text-xs">
              {link.pages.map((page) => (
                <li>
                  <a href={page.href} aria-current={at(page.href) ? 'page' : undefined} class:list={[row, at(page.href) ? 'bg-line-strong text-fg' : 'text-fg-subtle hover:text-fg']}>{page.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    })}
  </div>

  <Sheet id="main-nav" class="group lg:hidden">
    <button slot="trigger" type="button" popovertarget="main-nav" aria-label="Open navigation" class="py-1.5 flex items-center gap-2 shrink-0">
      <span>Menu</span>
      <Icon name="next" size="sm" class="rotate-90 text-fg-subtle transition-transform group-has-[[data-sheet]:popover-open]:-rotate-90" />
    </button>

    <div class="space-y-3 text-sm">
      {links.map((link) => (
        <div>
          <span class="block px-4 text-2xs text-fg-subtle">{link.label}</span>

          <ul class="mt-1">
            {link.pages.map((page) => (
              <li>
                <a href={page.href} aria-current={at(page.href) ? 'page' : undefined} class:list={[sheetRow, at(page.href) && 'bg-line-strong']}>{page.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Sheet>
</nav>

<style>
  [data-nav] > [data-nav-trigger] { anchor-name: var(--anchor) }

  .panel {
    position-anchor: var(--anchor);
    top: anchor(bottom);
    left: anchor(left);
    position-try-fallbacks: flip-inline;
  }
</style>

<script>
  const OPEN = 120
  const CLOSE = 260
  const DISMISS = 250

  const canHover = matchMedia('(hover: hover)')
  const shown = () => document.querySelector<HTMLElement>('[data-nav-panel]:popover-open')

  let timer: ReturnType<typeof setTimeout> | undefined
  let closedAt = -Infinity

  const after = (delay: number, run: () => void) => {
    clearTimeout(timer)
    timer = setTimeout(run, delay)
  }

  const hide = () => shown()?.hidePopover()

  function show(panel: HTMLElement) {
    if (shown() === panel) return
    hide()
    panel.showPopover()
  }

  document.querySelectorAll<HTMLElement>('[data-nav]').forEach((group) => {
    const panel = group.querySelector<HTMLElement>('[data-nav-panel]')
    const trigger = group.querySelector<HTMLElement>('[data-nav-trigger]')
    if (!panel || !trigger) return

    panel.addEventListener('beforetoggle', (event) => {
      const open = (event as ToggleEvent).newState === 'open'
      trigger.setAttribute('aria-expanded', String(open))
      if (!open) closedAt = event.timeStamp
    })

    group.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && canHover.matches) after(shown() ? 0 : OPEN, () => show(panel))
    })

    group.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse' && canHover.matches) after(CLOSE, hide)
    })

    trigger.addEventListener('focus', () => {
      if (trigger.matches(':focus-visible')) show(panel)
    })

    group.addEventListener('focusout', (event) => {
      if (!group.contains(event.relatedTarget as Node)) hide()
    })

    trigger.addEventListener('click', (event) => {
      if (panel.matches(':popover-open') || event.timeStamp - closedAt < DISMISS) hide()
      else show(panel)
    })
  })
</script>
