---
import Icon from '../ui/icon.astro'
import Dialog from '../ui/dialog.astro'

export type Token = { id: string; name: string; created: string; used: string | null; stops: string | null }

interface Props {
  tokens: Token[]
}

const { tokens } = Astro.props

const action = 'underline text-fg-hint transition'
const note = (token: Token) =>
  token.stops ? `Replaced, stops working ${token.stops}` : `Created ${token.created}, ${token.used ? `last used ${token.used}` : 'never used'}`
---

<div class="flex flex-col gap-6">
  <div>
    <h2 class="text-md">Tokens</h2>
    <p class="text-fg-hint mt-0.5">What the CLI publishes with. Treat them like passwords.</p>
  </div>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Your tokens</h3>

    {/* On its own the row is a button, so it reads as a pill until there are tokens to hold. */}
    <div data-card class:list={['bg-page border border-line-strong overflow-hidden', tokens.length ? 'rounded-2xl' : 'rounded-full']}>
      <ul data-list class="divide-y divide-line-strong">
        {tokens.map((token) => (
          <li class="flex items-center gap-3 px-4 py-3" data-token={token.id} data-name={token.name}>
            <Icon name="key" size="lg" class="shrink-0 text-fg-subtle" />

            <div class="min-w-0 flex-1">
              <p class="truncate">{token.name}</p>
              <p data-note class="truncate text-2xs text-fg-hint">{note(token)}</p>
            </div>

            <div class="shrink-0 flex items-center gap-3 text-xs">
              {!token.stops && <button type="button" data-rotate class:list={[action, 'hover:text-fg']}>Rotate</button>}
              <button type="button" data-revoke class:list={[action, 'hover:text-danger']}>Revoke</button>
            </div>
          </li>
        ))}

        {/* The row owns the height, so naming a token swaps what fills it rather than growing it. */}
        <li data-new class="h-9">
          <button type="button" data-add class="flex h-full w-full items-center justify-center gap-2 px-4 text-fg-hint transition hover:bg-surface hover:text-fg">
            <Icon name="close" size="sm" class="rotate-45" />
            <span>Create new</span>
          </button>

          <form data-new-token hidden class="flex h-full items-center gap-3 px-4">
            <Icon name="key" size="lg" class="shrink-0 text-fg-subtle" />

            <input
              name="token-name"
              placeholder="Name"
              autocomplete="off"
              maxlength="40"
              required
              class="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-fg-placeholder"
            />

            <div class="shrink-0 flex items-center gap-3 text-xs">
              <button type="submit" class:list={[action, 'hover:text-fg']}>Generate</button>
              <button type="button" data-cancel class:list={[action, 'hover:text-fg']}>Cancel</button>
            </div>
          </form>
        </li>
      </ul>
    </div>

    <p data-error hidden class="ml-4 text-2xs text-danger"></p>
    <p class="ml-4 text-2xs text-fg-hint">Rotate issues a new secret and leaves the old one working for a day, so a deploy has time to catch up. Revoke takes one out right away.</p>
  </section>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Using it</h3>

    <div class="bg-page border border-line-strong rounded-2xl p-4">
      <pre class="m-0 overflow-auto whitespace-pre font-mono text-xs leading-code [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">export EDGE_TOKEN=edge_pat_...
edge build
edge publish app.edge</pre>
    </div>

    <p class="ml-4 text-2xs text-fg-hint">Both run at the project root, build packs the .edge and publish uploads it.</p>
  </section>
</div>

{/* One copy of a row's markup, cloned for a token the page did not render. */}
<template data-row>
  <li class="flex items-center gap-3 px-4 py-3">
    <Icon name="key" size="lg" class="shrink-0 text-fg-subtle" />

    <div class="min-w-0 flex-1">
      <p data-row-name class="truncate"></p>
      <p data-note class="truncate text-2xs text-fg-hint"></p>
    </div>

    <div class="shrink-0 flex items-center gap-3 text-xs">
      <button type="button" data-rotate class:list={[action, 'hover:text-fg']}>Rotate</button>
      <button type="button" data-revoke class:list={[action, 'hover:text-danger']}>Revoke</button>
    </div>
  </li>
</template>

<Dialog id="token" title="Please copy this token" subtitle="It is shown this one time. Store it somewhere safe before you close this.">
  <div class="flex items-center gap-3 rounded-2xl border border-line-emphasis bg-surface px-4 py-2">
    <code data-secret class="min-w-0 flex-1 truncate font-mono text-xs"></code>

    <button type="button" data-copy class="shrink-0 flex items-center gap-1.5 text-2xs text-fg-hint transition hover:text-fg-muted">
      <Icon name="file" size="2xs" /><span data-copy-label>Copy</span>
    </button>
  </div>
</Dialog>

<script>
  import { createToken, revokeToken } from '../../lib/account/tokens'
  import { confirmed } from '../../lib/account/confirm'

  const RESET = 1200

  const DAY = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', year: 'numeric' })
  const CLOCK = new Intl.DateTimeFormat('en', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })

  const card = document.querySelector<HTMLElement>('[data-card]')
  const list = document.querySelector<HTMLElement>('[data-list]')
  const template = document.querySelector<HTMLTemplateElement>('[data-row]')
  const blank = document.querySelector<HTMLElement>('[data-new]')
  const dialog = document.querySelector<HTMLDialogElement>('[data-dialog="token"]')
  const secretText = document.querySelector<HTMLElement>('[data-secret]')
  const error = document.querySelector<HTMLElement>('[data-error]')
  const add = document.querySelector<HTMLButtonElement>('[data-add]')
  const form = document.querySelector<HTMLFormElement>('[data-new-token]')
  const input = form?.querySelector('input')

  // The row turns into the token it is about to make, then goes back to being a button.
  const naming = (on: boolean) => {
    if (!add || !form) return
    add.hidden = on
    form.hidden = !on
    if (on) input?.focus()
    else form.reset()
  }

  const complain = (reason: string) => {
    if (!error) return
    error.textContent = reason
    error.hidden = false
  }

  const clear = () => error && (error.hidden = true)

  const reveal = (token: string) => {
    if (!secretText || !dialog) return
    secretText.textContent = token
    dialog.showModal()
  }

  /* A pill while the row stands alone, a card once it has tokens above it. */
  function shape() {
    const holds = (list?.querySelectorAll('[data-token]').length ?? 0) > 0
    card?.classList.toggle('rounded-2xl', holds)
    card?.classList.toggle('rounded-full', !holds)
  }

  /* A token the server just made, placed newest first the way the page orders them. */
  function addRow(id: string, name: string) {
    const row = template?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined
    if (!row || !list || !blank) return

    row.dataset.token = id
    row.dataset.name = name
    row.querySelector('[data-row-name]')!.textContent = name
    row.querySelector('[data-note]')!.textContent = `Created ${DAY.format(Date.now())}, never used`

    list.insertBefore(row, list.firstElementChild === blank ? blank : list.firstElementChild)
    shape()
  }

  /* The token a replacement pushed out, still working until its clock runs down. */
  function markReplaced(row: HTMLElement, stops: number) {
    row.querySelector('[data-note]')!.textContent = `Replaced, stops working ${CLOCK.format(stops)}`
    row.querySelector('[data-rotate]')?.remove()
  }

  const busy = (button: HTMLButtonElement, on: boolean) => {
    button.disabled = on
    button.classList.toggle('opacity-50', on)
  }

  add?.addEventListener('click', () => naming(true))
  form?.querySelector('[data-cancel]')?.addEventListener('click', () => naming(false))

  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    clear()

    const name = input?.value.trim()
    if (!name) return

    naming(false)

    try {
      const made = await createToken(name)
      addRow(made.id, name)
      reveal(made.token)
    } catch (problem) {
      complain((problem as Error).message)
    }
  })

  // Delegated, so a row the page never rendered answers the same as one it did.
  list?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button')
    const row = button?.closest<HTMLElement>('[data-token]')
    if (!button || !row) return

    const id = row.dataset.token
    const name = row.dataset.name
    if (!id || !name) return

    // Revoking is the only one without a way back, rotating leaves the old token a day.
    const revoking = 'revoke' in button.dataset

    if (revoking && !(await confirmed({
      title: `Revoke ${name}?`,
      body: 'Anything publishing with this token stops working right away, and it cannot be brought back.',
      action: 'Revoke token'
    }))) return

    clear()
    busy(button, true)

    try {
      if (revoking) {
        await revokeToken(id)
        row.remove()
        shape()
        return
      }

      // A rotation is a create that names what it replaces, so the old row stays and starts a clock.
      const made = await createToken(name, id)
      addRow(made.id, name)
      if (made.stops !== null) markReplaced(row, made.stops)
      reveal(made.token)
    } catch (problem) {
      complain((problem as Error).message)
      busy(button, false)
    }
  })

  let timer: ReturnType<typeof setTimeout> | undefined

  document.querySelector('[data-copy]')?.addEventListener('click', async () => {
    const label = document.querySelector<HTMLElement>('[data-copy-label]')
    if (!label || !secretText) return

    try {
      await navigator.clipboard.writeText(secretText.textContent ?? '')
      label.textContent = 'Copied'
    } catch {
      label.textContent = "Couldn't copy"
    }

    clearTimeout(timer)
    timer = setTimeout(() => { label.textContent = 'Copy' }, RESET)
  })
</script>
