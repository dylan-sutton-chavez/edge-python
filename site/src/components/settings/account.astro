---
import Icon from '../ui/icon.astro'
import type { Me } from '../../lib/account/auth'
import { isConfigured } from '../../lib/server/oauth'

interface Props {
  user: Me
  linked: string[]
}

const { user, linked } = Astro.props

// A linked provider stays listed so it can still be disconnected.
const providers = ([
  { id: 'github', name: 'GitHub', icon: 'github' },
  { id: 'google', name: 'Google', icon: 'google' }
] as const).filter(({ id }) => isConfigured(id) || linked.includes(id))

const card = 'bg-page border border-line-strong p-4'
---

<div class="flex flex-col gap-6">
  <div>
    <h2 class="text-md">Account</h2>
    <p class="text-fg-hint mt-0.5">How you sign in. None of this is public.</p>
  </div>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Email</h3>

    <div class:list={[card, 'rounded-2xl flex items-center gap-3']}>
      <Icon name="mail" size="lg" class="shrink-0 text-fg-subtle" />
      <span data-address class="min-w-0 flex-1 truncate font-mono text-xs">{user.email}</span>

      <button type="button" data-move class="shrink-0 text-xs underline text-fg-hint hover:text-fg transition">Change</button>

      <form data-move-form hidden class="min-w-0 flex-1 flex items-center gap-3">
        <input
          name="new-address"
          type="email"
          placeholder="you@example.com"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          class="min-w-0 flex-1 bg-transparent font-mono text-xs outline-none placeholder:text-fg-placeholder"
        />

        <div class="shrink-0 flex items-center gap-3 text-xs">
          <button type="submit" class="underline text-fg-hint hover:text-fg transition">Send code</button>
          <button type="button" data-move-cancel class="underline text-fg-hint hover:text-fg transition">Cancel</button>
        </div>
      </form>
    </div>

    <p data-move-error hidden class="ml-4 text-2xs text-danger"></p>
    <p class="ml-4 text-2xs text-fg-hint">Sign-in codes go to this address.</p>
  </section>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Sign-in methods</h3>

    <div class="bg-page border border-line-strong rounded-2xl overflow-hidden">
      <ul class="divide-y divide-line-strong">
        <li class="flex items-center gap-3 px-4 py-3">
          <Icon name="glasses" size="lg" class="shrink-0 text-fg-subtle" />

          <div class="min-w-0 flex-1">
            <p>Email code</p>
            <p class="truncate text-2xs text-fg-hint">Always on. A six-digit code, valid for ten minutes.</p>
          </div>

          <span class="shrink-0 text-2xs text-fg-hint">Default</span>
        </li>

        {providers.map(({ id, name, icon }) => (
          <li class="flex items-center gap-3 px-4 py-3">
            <Icon name={icon} size="lg" class="shrink-0 text-fg-subtle" />

            <div class="min-w-0 flex-1">
              <p>{name}</p>
              <p class="truncate text-2xs text-fg-hint">{linked.includes(id) ? 'Connected' : 'Not connected'}</p>
            </div>

            {linked.includes(id) ? (
              <button type="button" data-disconnect={id} class="shrink-0 text-xs underline text-fg-hint hover:text-danger transition">Disconnect</button>
            ) : (
              <a href={`/api/auth/${id}`} class="shrink-0 text-xs underline text-link">Connect</a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <p class="ml-4 text-2xs text-fg-hint">The email code always works, so disconnecting a provider never locks you out.</p>
  </section>

  <section class="flex flex-col gap-2">
    <h3 class="ml-4">Delete account</h3>

    <div class:list={[card, 'rounded-2xl flex flex-col gap-4 sm:flex-row sm:items-center']}>
      <p class="min-w-0 flex-1 text-fg-muted">Your profile and sign-in methods go with it. This cannot be undone.</p>

      <button type="button" data-delete data-email={user.email} class="shrink-0 text-sm flex items-center gap-2 transition border border-line text-fg-hint px-4 py-1 rounded-full hover:text-danger">
        <Icon name="trash" />Delete
      </button>
    </div>
  </section>
</div>

<script>
  import { changeEmail, deleteAccount, disconnect, sendCode, startEmailChange } from '../../lib/account/auth'
  import { confirmedWithCode } from '../../lib/account/confirm'

  const address = document.querySelector<HTMLElement>('[data-address]')
  const move = document.querySelector<HTMLButtonElement>('[data-move]')
  const moveForm = document.querySelector<HTMLFormElement>('[data-move-form]')
  const moveError = document.querySelector<HTMLElement>('[data-move-error]')

  // The row turns into the field, then goes back to being a button.
  const moving = (on: boolean) => {
    if (!move || !moveForm || !address) return
    move.hidden = on
    address.hidden = on
    moveForm.hidden = !on
    if (on) moveForm.querySelector('input')?.focus()
    else moveForm.reset()
  }

  move?.addEventListener('click', () => moving(true))
  moveForm?.querySelector('[data-move-cancel]')?.addEventListener('click', () => moving(false))

  moveForm?.addEventListener('submit', async (event) => {
    event.preventDefault()
    if (moveError) moveError.hidden = true

    const wanted = moveForm.querySelector('input')?.value.trim().toLowerCase()
    if (!wanted) return

    try {
      await startEmailChange(wanted)
      moving(false)

      const code = await confirmedWithCode({
        title: `Send your codes to ${wanted}?`,
        body: 'The old address stops reaching this account, and we will let it know. Your GitHub and Google connections are unaffected.',
        action: 'Change address'
      })

      if (!code) return

      const moved = await changeEmail(wanted, code)
      if (address) address.textContent = moved.email
    } catch (problem) {
      if (moveError) {
        moveError.textContent = (problem as Error).message
        moveError.hidden = false
      }
      moving(false)
    }
  })

  document.querySelectorAll<HTMLButtonElement>('[data-disconnect]').forEach((button) => {
    button.addEventListener('click', async () => {
      await disconnect(button.dataset.disconnect!)
      location.reload()
    })
  })

  // A live session is not enough to end an account, so a fresh code has to come back from the mailbox first.
  document.querySelector<HTMLButtonElement>('[data-delete]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLButtonElement
    const email = button.dataset.email
    if (!email) return

    button.disabled = true

    try {
      await sendCode(email)

      const code = await confirmedWithCode({
        title: 'Delete your account?',
        body: 'Your profile, your sign-in methods and your publish tokens go with it. Nothing here comes back.',
        action: 'Delete account'
      })

      if (code) {
        await deleteAccount(code)
        location.replace('/')
        return
      }
    } catch (problem) {
      alert((problem as Error).message)
    }

    button.disabled = false
  })
</script>
