{
  "name": "site",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "config": "tsx wrangler.config.ts",
    "types": "npm run config && wrangler types",
    "db:local": "npm run config && tsx db/local.ts",
    "dev": "npm run db:local && astro dev",
    "card": "tsx scripts/card.ts",
    "docs": "tsx scripts/docs.ts",
    "build": "npm run config && npm run docs && npm run card && astro build",
    "preview": "npm run config && astro preview",
    "deploy": "npm run build && wrangler deploy",
    "check": "npm run types && astro check --minimumSeverity warning",
    "test": "npm run db:local && playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "acorn": "^8.18.0",
    "acorn-globals": "^7.0.1",
    "astro": "^7.3.2",
    "astro-seo-schema": "^7.0.0",
    "schema-dts": "^1.1.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@mdn/browser-compat-data": "^8.1.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.134.0"
  }
}
